---
import { formatDay, toISO } from "../utils/dates";

const { url, title, description, tags = [], pubDate } = Astro.props;
// ISO dates line up in a monospace column, which a spelled-out month does not
const date = pubDate ? formatDay(pubDate) : "";
---
<li class="post-item" data-tags={tags.join("|")}>
    <a class="post-link" href={url}>
        <span class="post-title">{title}</span>
        <span class="post-leader" aria-hidden="true"></span>
        <time class="post-meta" datetime={pubDate ? toISO(pubDate) : undefined}>{date}</time>
    </a>
    {description && <p class="post-desc">{description}</p>}
    {
        tags.length > 0 && (
            <ul class="tags">
                {tags.map((tag: string) => (
                    <li class="tag">{tag}</li>
                ))}
            </ul>
        )
    }
</li>
