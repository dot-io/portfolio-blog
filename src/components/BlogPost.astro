---
const { url, title, tags = [], pubDate } = Astro.props;
const date = pubDate
  ? new Date(pubDate).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "short",
      year: "numeric",
    })
  : "";
---
<li class="post-item" data-tags={tags.join("|")}>
    <a class="post-link" href={url}>
        <span>{title}</span>
        <span class="post-meta">
            {date}
            <span class="arrow" aria-hidden="true">&#8594;</span>
        </span>
    </a>
    {
        tags.length > 0 && (
            <ul class="tags">
                {tags.map((tag: string) => (
                    <li class="tag">{tag}</li>
                ))}
            </ul>
        )
    }
</li>
