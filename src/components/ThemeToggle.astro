---
---
<button id="themeToggle" type="button" role="switch" aria-checked="false" aria-label="Dark mode">
  <span class="track">
    <span class="knob">
      <svg class="sun" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path fill-rule="evenodd" d="M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zm0 1.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm12-7a.8.8 0 0 1-.8.8h-2.4a.8.8 0 0 1 0-1.6h2.4a.8.8 0 0 1 .8.8zM4 12a.8.8 0 0 1-.8.8H.8a.8.8 0 0 1 0-1.6h2.5a.8.8 0 0 1 .8.8zm16.5-8.5a.8.8 0 0 1 0 1l-1.8 1.8a.8.8 0 0 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM6.3 17.7a.8.8 0 0 1 0 1l-1.7 1.8a.8.8 0 1 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM12 0a.8.8 0 0 1 .8.8v2.5a.8.8 0 0 1-1.6 0V.8A.8.8 0 0 1 12 0zm0 20a.8.8 0 0 1 .8.8v2.4a.8.8 0 0 1-1.6 0v-2.4a.8.8 0 0 1 .8-.8zM3.5 3.5a.8.8 0 0 1 1 0l1.8 1.8a.8.8 0 1 1-1 1L3.5 4.6a.8.8 0 0 1 0-1zm14.2 14.2a.8.8 0 0 1 1 0l1.8 1.7a.8.8 0 0 1-1 1l-1.8-1.7a.8.8 0 0 1 0-1z"/>
      </svg>
      <svg class="moon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path fill-rule="evenodd" d="M16.5 6A10.5 10.5 0 0 1 4.7 16.4 8.5 8.5 0 1 0 16.4 4.7l.1 1.3zm-1.7-2a9 9 0 0 1 .2 2 9 9 0 0 1-11 8.8 9.4 9.4 0 0 1-.8-.3c-.4 0-.8.3-.7.7a10 10 0 0 0 .3.8 10 10 0 0 0 9.2 6 10 10 0 0 0 4-19.2 9.7 9.7 0 0 0-.9-.3c-.3-.1-.7.3-.6.7a9 9 0 0 1 .3.8z"/>
      </svg>
    </span>
  </span>
</button>

<style>
  #themeToggle {
    padding: 0;
    border: 0;
    background: none;
    line-height: 0;
    cursor: pointer;
    border-radius: 999px;
  }

  .track {
    position: relative;
    display: block;
    width: 50px;
    height: 26px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  /* night side of the switch carries a wash of gold */
  :global(.dark) .track {
    background: color-mix(in srgb, var(--gold) 15%, transparent);
  }

  #themeToggle:hover .track,
  #themeToggle:focus-visible .track {
    border-color: var(--accent);
  }

  .knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--on-gold);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      background 0.3s ease, box-shadow 0.3s ease;
  }

  /* 48px of track, less the 20px knob and its 2px margins */
  :global(.dark) .knob {
    transform: translateX(24px);
  }

  #themeToggle:hover .knob {
    box-shadow: 0 0 12px var(--glow);
  }

  .knob svg {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 12px;
    height: 12px;
    fill: currentColor;
    transition: opacity 0.3s ease;
  }

  .moon,
  :global(.dark) .sun {
    opacity: 0;
  }

  .sun,
  :global(.dark) .moon {
    opacity: 1;
  }
</style>

<script is:inline>
  const theme = (() => {
    const localStorageTheme = localStorage?.getItem("theme") ?? '';
    if (['dark', 'light'].includes(localStorageTheme)) {
      return localStorageTheme;
    }
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      return 'dark';
    }
      return 'light';
  })();

  if (theme === 'light') {
    document.documentElement.classList.remove('dark');
  } else {
    document.documentElement.classList.add('dark');
  }

  window.localStorage.setItem('theme', theme);

  const syncSwitch = (isDark) => {
    document.getElementById("themeToggle")?.setAttribute("aria-checked", String(isDark));
  };

  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle("dark");

    const isDark = element.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    syncSwitch(isDark);
  }

  document.addEventListener("DOMContentLoaded", () => {
    syncSwitch(document.documentElement.classList.contains("dark"));
    document.getElementById("themeToggle")?.addEventListener("click", handleToggleClick);
  });
</script>
