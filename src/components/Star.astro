---
// Four-pointed star with concave, curved spikes — the site's one ornament.
const { size = 16, class: className } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M12 0 C12.9 6.6 17.4 11.1 24 12 C17.4 12.9 12.9 17.4 12 24 C11.1 17.4 6.6 12.9 0 12 C6.6 11.1 11.1 6.6 12 0 Z"
  ></path>
</svg>

<style>
  svg {
    display: block;
    flex: none;
    overflow: visible;
  }

  path {
    fill: currentColor;
  }
</style>
