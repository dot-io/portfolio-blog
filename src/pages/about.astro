---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "About Me";
const identity = {
  firstName: "Nathan",
  country: "Belgium",
  occupation: "Software Engineer",
  hobbies: ["gym", "running", "chess"],
};
const skills = ["Python", "C/C++", "LLVM IR", "Git", "SQL", "LaTeX"];
---

<BaseLayout
  pageTitle={pageTitle}
  eyebrow="Provenance"
  subtitle="A short account of the chronicler's life."
>
  <p>
    I am {identity.firstName}, based in {identity.country}, working as a {identity.occupation}.
    </p>

  <p>
    My hobbies are {identity.hobbies[0]}, {identity.hobbies[1]} and {identity.hobbies[2]}, that mostly teaches me patience.
  </p>

  <h2>Skills</h2>
  <ul class="tags">
    {skills.map((skill) => <li class="tag">{skill}</li>)}
  </ul>

  <h2>Elsewhere</h2>
  <p>
    Project history lives on the <a href="/projects/">timeline</a>, and looser notes go
    in the <a href="/blog/">blog</a>.
  </p>
</BaseLayout>
