---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
const pubDate = new Date(frontmatter.pubDate).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---
<BaseLayout
  pageTitle={frontmatter.title}
  eyebrow={pubDate}
  subtitle={frontmatter.description}
>
  <p class="byline">Written by {frontmatter.author}</p>
  <img class="hero" src={frontmatter.image.url} alt={frontmatter.image.alt} />
  <ul class="tags">
    {frontmatter.tags.map((tag: string) => (
      <li class="tag"><a href={`/blog/?tag=${encodeURIComponent(tag)}`}>{tag}</a></li>
    ))}
  </ul>
  <article>
    <slot />
  </article>
</BaseLayout>

<style>
  .byline {
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero {
    width: 100%;
    margin: 1.5rem 0;
    border: 1px solid var(--line);
    filter: saturate(0.85);
  }

  article :global(h1) {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
  }
</style>
